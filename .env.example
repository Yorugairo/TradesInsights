# PostgreSQL (docker compose default)
DATABASE_URL=postgres://otn:otn@localhost:5432/otn

# S3-compatible object storage (MinIO locally)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=otn-artifacts
OBJECT_STORAGE_ACCESS_KEY=otn-minio
OBJECT_STORAGE_SECRET_KEY=otn-minio-secret

# Web application
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=dev-only-change-me

# Email (Mailpit locally)
EMAIL_FROM=insights@otn.local
# P2.3 — base URL embedded in one-tap digest action links (pursue/dismiss).
# Unset disables action links entirely.
ACTION_BASE_URL=http://localhost:3000
ALERTS_EMAIL=ops@otn.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Model providers — the app must boot WITHOUT these.
# Model-dependent jobs enter a visible blocked/skipped state when unset.
# Provider selection (first configured key wins): OpenRouter, then Anthropic.
#
# OpenRouter (OpenAI-compatible; routes to many models). Set BOTH the key and a
# model slug — no slug is guessed. Cost is read from OpenRouter's own usage.cost
# (authoritative) so the monthly budget ledger stays honest.
OPENROUTER_API_KEY=
# e.g. anthropic/claude-opus-4.1 · openai/gpt-4o · google/gemini-2.5-pro
OPENROUTER_MODEL=
# Optional attribution headers OpenRouter uses for model rankings (non-critical).
OPENROUTER_REFERER=
OPENROUTER_TITLE=OTN Insights
#
# Anthropic direct (used only when OPENROUTER_API_KEY is unset).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
#
# Budgets (spec §13). A monthly cap is REQUIRED to run model jobs at all.
LLM_MONTHLY_BUDGET_USD=
# Per-job worst-case cap (defaults to 0.50 when unset)
LLM_JOB_BUDGET_USD=

# Identifies our collectors to source operators (required to run adapters)
SOURCE_USER_AGENT="OTNInsightsBot/0.1 (construction opportunity research; contact: ops@otn.local)"
