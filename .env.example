# PostgreSQL — the search_path contract (Part E co-location) rides the URL:
# `insights` first (all Insights tables live there), then `public`, then
# `extensions` (PostGIS on Supabase; silently skipped where absent, e.g. local
# Docker). Keep the value URL-ENCODED exactly as below — never export an
# unencoded form from a shell.
#
# Local (docker compose default; use :5433 if a native Postgres owns 5432):
DATABASE_URL=postgres://otn:otn@localhost:5432/otn?options=-csearch_path%3Dinsights%2Cpublic%2Cextensions
#
# Hosted (Supabase co-location) shape — owner sets the real credentials:
#   postgres://<user>:<password>@<project-pooler-host>:5432/postgres?options=-csearch_path%3Dinsights%2Cpublic%2Cextensions
# MUST use the SESSION pooler on :5432. NEVER the transaction pooler (:6543) —
# pg-boss (polling + advisory locks) breaks under transaction pooling.

# One Trade Network registry — read-only connection to the registry's contract
# surface (registry_public.trades_identity_v1). The registry-link step binds
# organizations to canonical registry entities by strong identifier (ubi /
# contractor_number). UNSET ⇒ the step reports a visible "skipped" state and the
# pipeline runs normally. Use a credential that is a member of the read-only
# `otn_insights_reader` role (SELECT on registry_public only). Once Insights and
# the registry co-locate (integration doc Part E), this points at the same DB.
REGISTRY_DATABASE_URL=

# S3-compatible object storage (MinIO locally)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=otn-artifacts
OBJECT_STORAGE_ACCESS_KEY=otn-minio
OBJECT_STORAGE_SECRET_KEY=otn-minio-secret

# Web application
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=dev-only-change-me

# Email (Mailpit locally)
EMAIL_FROM=insights@otn.local
# P2.3 — base URL embedded in one-tap digest action links (pursue/dismiss).
# Unset disables action links entirely.
ACTION_BASE_URL=http://localhost:3000
ALERTS_EMAIL=ops@otn.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Model providers — the app must boot WITHOUT these.
# Model-dependent jobs enter a visible blocked/skipped state when unset.
# Provider selection (first configured key wins): OpenRouter, then Anthropic.
#
# OpenRouter (OpenAI-compatible; routes to many models). Set BOTH the key and a
# model slug — no slug is guessed. Cost is read from OpenRouter's own usage.cost
# (authoritative) so the monthly budget ledger stays honest.
OPENROUTER_API_KEY=
# e.g. anthropic/claude-opus-4.1 · openai/gpt-4o · google/gemini-2.5-pro
OPENROUTER_MODEL=
# Optional attribution headers OpenRouter uses for model rankings (non-critical).
OPENROUTER_REFERER=
OPENROUTER_TITLE=OTN Insights
#
# Anthropic direct (used only when OPENROUTER_API_KEY is unset).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
#
# Budgets (spec §13). A monthly cap is REQUIRED to run model jobs at all.
LLM_MONTHLY_BUDGET_USD=
# Per-job worst-case cap (defaults to 0.50 when unset)
LLM_JOB_BUDGET_USD=

# Identifies our collectors to source operators (required to run adapters)
SOURCE_USER_AGENT="OTNInsightsBot/0.1 (construction opportunity research; contact: ops@otn.local)"

# Customer bid inbox (M4.6 — blocked until authorized). Two delivery modes;
# set the one matching how this customer forwards bid invitations. Never
# scraped — customer-provided only.
#
# Signed webhook intake: guards POST /api/webhooks/inbound-email/{provider}.
# UNSET ⇒ the route returns 503 "not configured" (never accepts unauthenticated
# mail). Compared against the inbound provider's `x-inbound-secret` header.
INBOUND_EMAIL_SECRET=
#
# Local JSON-drop intake: directory customer_bid_inbox_<account> sources read
# customer-provided JSON exports from. UNSET ⇒ adapters fall back to the test
# fixtures dir — fine in dev, but means no live inbox in production.
CUSTOMER_BID_INBOX_DIR=
